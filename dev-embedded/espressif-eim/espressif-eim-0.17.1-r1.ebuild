# See https://docs.espressif.com/projects/idf-im-ui/en/latest/prerequisites.html#python-version
PYTHON_COMPAT=( python3_{11,12,13,14} )

# See [Eclass Reference}(https://devmanual.gentoo.org/eclass-reference/index.html) for a list of eclasses.
inherit cargo python-r1

DESCRIPTION="ESP-IDF Installation Manager"
HOMEPAGE="https://github.com/espressif/idf-im-ui/"

# To get a list of all Cargo Crates,
#  - download source code archive from https://github.com/espressif/idf-im-ui/archive/refs/tags/v${PV}.tar.gz
#  - unpack it and
#  - run `pycargoebuild` on the `src-tauri` sub-directory
SRC_URI="
    https://github.com/espressif/idf-im-ui/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
    ${CARGO_CRATE_URIS}
"

# The tar-archive contains a sub-directory whose name differs from # the package name.
# Overwrite the source directory `$S` with the correct directory.
# The default is `${WORKDIR}/${P}`, see [Ebuild Writing - Ebuild-defined Variables](https://devmanual.gentoo.org/ebuild-writing/variables/index.html#ebuild-defined-variables)
S="${WORKDIR}/idf-im-ui-${PV}/src-tauri"

# Always download the source from upstream, do not try to download it from a
# Gentoo mirror.
# See [Ebuild Writing - Variables](https://devmanual.gentoo.org/ebuild-writing/variables/index.html)
# and `man 5 ebuild`.
RESTRICT="mirror"

LICENSE="Apache-2.0"
# Dependent crate licenses
LICENSE+="
        Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD Boost-1.0
        CC0-1.0 CDLA-Permissive-2.0 ISC LGPL-3 MIT MPL-2.0 Unicode-3.0
        Unicode-DFS-2016 ZLIB BZIP2
"

SLOT="0"
KEYWORDS="amd64"
IUSE="gui"

# See https://docs.espressif.com/projects/idf-im-ui/en/latest/prerequisites.html#linux
# and https://docs.espressif.com/projects/idf-im-ui/en/latest/prerequisites.html#arch-linux
RDEPEND="
        ${PYTHON_DEPS}
        app-mobilephone/dfu-util
        dev-embedded/esptool
        dev-embedded/libftdi
        dev-embedded/openocd
        dev-libs/glib:2
        dev-libs/libffi
        dev-libs/libgcrypt:0/20
        dev-libs/openssl
	dev-python/pip
        dev-util/ccache
        dev-util/gperf
        dev-vcs/git
        media-libs/libsdl2
        net-libs/libslirp
        gui? ( net-libs/webkit-gtk:4.1/0 )
        net-misc/wget
        sys-devel/bison
        sys-devel/flex
        virtual/libusb:1
        gui? ( x11-libs/pixman )"
BDEPEND="
        ${PYTHON_DEPS}
        || ( >=dev-lang/rust-${RUST_MIN_VER} >=dev-lang/rust-bin-${RUST_MIN_VER} )
	dev-python/pip
"

# See https://devmanual.gentoo.org/quickstart/index.html#ebuild-with-patches
PATCHES=(
	"${FILESDIR}/${P}-remove-telemetry.patch"
)


src_configure() {
	local myfeatures=(
		$(usev gui)
		cli
		vendored-openssl
	)
	cargo_src_configure --no-default-features
}


src_test() {
	# no-op as some tests try to break out of the sandbox
	return 0
}
